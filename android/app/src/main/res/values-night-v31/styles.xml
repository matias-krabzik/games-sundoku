<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SunDoku intentionally keeps its sunny launch palette in dark mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_sky</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_logo_android12</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_sky</item>
    </style>
</resources>
